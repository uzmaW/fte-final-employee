# AI Employee System Configuration
# Copy this to .env and fill in your actual values
# Never commit .env to version control!

# ============================================================================
# VAULT CONFIGURATION
# ============================================================================
VAULT_PATH=AI_Employee_Vault
SKILLS_PATH=.claude/skills
LOGS_DIR=AI_Employee_Vault/Logs
LOG_LEVEL=INFO
TIMEZONE=UTC

# ============================================================================
# GMAIL API CONFIGURATION
# ============================================================================
# Get these from: https://console.cloud.google.com/
GMAIL_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
GMAIL_POLL_INTERVAL=300

# ============================================================================
# WHATSAPP CONFIGURATION (Twilio)
# ============================================================================
# Get these from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=AC123456789...
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
WHATSAPP_POLL_INTERVAL=60

# ============================================================================
# PAYMENT PROCESSING (Stripe)
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_live_your_key_here
STRIPE_SIGNING_SECRET=whsec_your_secret_here

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================
WATCHDOG_CHECK_INTERVAL=30
MAX_RETRIES=3
RETRY_BACKOFF=1.0

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_GMAIL_WATCHER=false
ENABLE_WHATSAPP_WATCHER=false
ENABLE_ORCHESTRATOR=false
ENABLE_WATCHDOG=false

# ============================================================================
# ODOO CONFIGURATION (Accounting)
# ============================================================================
# Odoo instance URL (self-hosted or Odoo Online)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_db
ODOO_USER=admin
ODOO_PASSWORD=admin

# ============================================================================
# TESTING
# ============================================================================
TEST_MODE=false
